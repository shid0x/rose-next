include "common/char_move_mode.fbs";
include "common/vec3.fbs";

namespace Rose.Network.Packets;

enum DamagePresentationKind : byte {
	MeleeHitFrame = 0,
	ProjectileImpact = 1,
	Immediate = 2,
	StatusTick = 3,
	MissingAttacker = 4,
}

table DamageEvent {
	event_id: uint32;
	defender_seq: uint32;
	attacker_id: uint32;
	defender_id: uint32;
	raw_damage: uint32;
	damage_value: int32;
	hp_after: int32;
	presentation_kind: DamagePresentationKind;
	lethal: bool;
	// LIST_SKILL row that produced this damage, 0 = normal attack / unknown.
	// Display metadata only (damage meter attribution); presentation logic
	// must not branch on it.
	skill_id: int32;
	// Object index of the character that ultimately caused this damage when it
	// differs from attacker_id: the DoT caster (status ticks put the victim in
	// attacker_id) or a summon's owner. 0 = same as attacker_id / unknown.
	// Display metadata only, same contract as skill_id — presentation keys on
	// attacker_id and must never branch on this.
	source_attacker_id: uint32;
}

table CombatSwing {
	attacker_id: uint32;
	defender_id: uint32;
	target_distance: uint16;
	target_pos: Vec3;
	move_mode: CharacterMoveMode;
	damage: DamageEvent;
}

root_type CombatSwing;
