/* UI2 skill bar -- LAYOUT ONLY ( colours and materials: rose-theme.rcss ).
   Reload in game with /uireload. RoseRmlSkillBar centres it at the bottom of
   the screen until it is dragged ( by the grip ) or restored.

   PERFORMANCE: fixed-size floats, not flexbox, and a definite width -- see
   shop.rcss. RmlUi re-lays out the whole document on any change, and this one
   changes constantly in a fight: the cooldown curtains therefore move by
   `transform` ( no layout at all ) and show by visibility, not by height and
   data-if.

   Horizontal: the grip ( 9 wide with its border, then 3 ) and two rows of
   pager ( 22 + 3 ) + 8 slots x ( 42 + 2 ) = 377 -- 389 in all. */

#skillbar {
    left: 0dp;
    top: 0dp;
    display: block;
    width: 389dp;
    padding: 3dp;
}

/* --- grip: the only drag handle, so slots stay free for their own drags ---- */
.grip {
    float: left;
    width: 7dp;
    height: 84dp;              /* two rows ( 42 + 2 + 42 ) less its border */
    margin-right: 3dp;
    border: 1dp #565656ff;
    border-radius: 2dp;
    background-color: #3a3a3aff;
    decorator: ui-gloss-soft;
    cursor: move;
}
body.locked .grip { cursor: default; }

.rows {
    float: left;
    width: 377dp;
}

.row {
    display: flow-root;
    height: 42dp;
}
.row + .row { margin-top: 2dp; }

/* --- page number and arrows ----------------------------------------------- */
.pager {
    float: left;
    width: 22dp;
    height: 42dp;
    margin-right: 3dp;
    text-align: center;
}
.page {
    display: block;
    font-size: 13dp;
    font-weight: bold;
    font-effect: shadow(1px 1px #000000c0);
}
.arrows { display: block; }
.arrow {
    display: inline-block;
    width: 11dp;
    text-align: center;
    font-size: 13dp;
    font-weight: bold;
    color: #9a9a9a;
    cursor: pointer;
}
.arrow:hover { color: #ff9a5a; }

/* --- slots ------------------------------------------------------------------ */
/* .ui-icon ( theme ) is the dark backing square, a flex box that centres; here
   a plain block, positioned so the cooldown curtain and the labels can sit on
   top of the icon.
   Icons are drawn at their NATIVE atlas size, exactly as the classic bar
   draws them: 40x40 for most items, 39x39 for every skill. So the img gets
   NO width/height -- RmlUi then sizes it from its rect, times the UI scale --
   and it is pinned top-left instead of centred: a 39 px sprite centred in a
   40 px box lands on a half pixel and every texel is blurred across two.
   The slot is the 40 px cell plus its 1 dp rim, border included. */
.slot {
    float: left;
    display: block;
    position: relative;
    box-sizing: border-box;
    width: 42dp;
    height: 42dp;
    margin-right: 2dp;
    cursor: pointer;
}
.slot:hover { border-color: #d0501aff; }
.slot.empty { background-color: #00000060; cursor: default; }
.slot.empty:hover { border-color: #000000c0; }

/* Present but unusable ( wrong weapon, not enough MP ... ). */
.slot.off img { image-color: #707070; }

/* Cooldown: a curtain that drains from the top as the reload runs down. Full
   height, shrunk towards the bottom by a transform ( the markup binds
   scaleY ): a changing height would re-lay out the bar at every percent. */
.cd {
    position: absolute;
    left: 1dp;
    right: 1dp;
    top: 1dp;
    bottom: 1dp;
    border-radius: 3dp;
    background-color: #000000b0;
    transform-origin: 50% 100%;
}
.cd-text {
    position: absolute;
    left: 0dp;
    right: 0dp;
    top: 0dp;
    line-height: 40dp;
    text-align: center;
    font-size: 14dp;
    font-weight: bold;
    color: #ffffff;
    font-effect: outline(1px #000000e0);
}

/* Stack count, bottom right; key label, top left. */
.count {
    position: absolute;
    right: 3dp;
    bottom: 1dp;
    font-size: 10dp;
    font-weight: bold;
    color: #ffffff;
    font-effect: outline(1px #000000e0);
}
.key {
    position: absolute;
    left: 3dp;
    top: 1dp;
    font-size: 8dp;
    color: #d8d8d8;
    font-effect: outline(1px #000000e0);
}

/* --- vertical layout ( [VIDEO] UI_SKILLBAR_VERTICAL ) -------------------------
   The same elements, turned: the grip on top, the two rows as two columns
   ( 42 + 2 + 42 = 86 wide ), each column's pager above its slots. */
#skillbar.vertical { width: 86dp; }

#skillbar.vertical .grip {
    float: none;
    width: auto;
    height: 7dp;
    margin-right: 0dp;
    margin-bottom: 3dp;
}

#skillbar.vertical .rows {
    float: none;
    display: flow-root;
    width: 86dp;
}
#skillbar.vertical .row {
    float: left;
    width: 42dp;
    height: auto;
}
#skillbar.vertical .row + .row {
    margin-top: 0dp;
    margin-left: 2dp;
}

/* The pager lies flat above its column: page number, then the arrows. */
#skillbar.vertical .pager {
    float: none;
    width: 42dp;
    height: auto;
    margin-right: 0dp;
    margin-bottom: 3dp;
}
#skillbar.vertical .page {
    display: inline-block;
    margin-left: 3dp;
    margin-right: 3dp;
}
#skillbar.vertical .arrows { display: inline-block; }
#skillbar.vertical .slot {
    float: none;
    margin-right: 0dp;
    margin-bottom: 2dp;
}
