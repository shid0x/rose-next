/* UI2 player shop ( visiting ) -- LAYOUT ONLY ( colours and materials:
   rose-theme.rcss, plus the few colours that are this window's own states ).
   Reload in game with /uireload. The C++ places it beside the bag the first
   time, until it is moved.

   PERFORMANCE ( see shop.rcss ): the grid is fixed-size floats, the window
   has a definite width, flex only for the small rows. Six items of 42 + 2
   = 264, 1 of slack, the well's 4 of padding and 2 of border: 271. */

#avatarstore {
    left: 60dp;
    top: 160dp;
    display: block;
    width: 271dp;
}

/* The owner's name under the sign. */
.owner {
    height: 14dp;
    line-height: 14dp;
    margin-bottom: 4dp;
    padding: 0dp 3dp;
    font-size: 10dp;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* For sale / Wanted, each with how many. */
.tabs {
    display: flex;
    flex-direction: row;
    margin-bottom: 4dp;
}
.tab {
    flex: 1;
    padding-left: 4dp;
    padding-right: 4dp;
    font-size: 10dp;
    white-space: nowrap;
}
.tab + .tab { margin-left: 3dp; }
.tab .n {
    margin-left: 4dp;
    font-weight: normal;
    color: #9a9a9a;
}
.tab.on .n { color: #ffd2b8; }

.grid {
    display: flow-root;
    width: 265dp;
    padding: 3dp 1dp 0dp 3dp;
}

/* An item: its icon and its price under it, 42 x 54. */
.item {
    float: left;
    width: 42dp;
    height: 54dp;
    margin-right: 2dp;
    margin-bottom: 3dp;
    cursor: pointer;
}
.item.empty { cursor: default; }
.item:hover .cell { border-color: #d0501aff; }
.item.empty:hover .cell { border-color: #000000c0; }

/* .ui-icon ( theme ) is the dark backing square, a flex box that centres;
   here a plain block with the icon pinned top-left at its NATIVE atlas size
   ( 40x40 ). No width/height on the img. */
.cell {
    display: block;
    position: relative;
    box-sizing: border-box;
    width: 42dp;
    height: 42dp;
}
.item.empty .cell { background-color: #00000050; }

.gem {
    position: absolute;
    left: 0dp;
    top: 0dp;
}
.socket {
    position: absolute;
    left: 0dp;
    top: 0dp;
}

/* How many, top left, where the classic icon drew it. */
.count {
    position: absolute;
    left: 1dp;
    top: 1dp;
    padding: 0dp 2dp;
    line-height: 12dp;
    font-size: 10dp;
    font-weight: bold;
    color: #ffffff;
    border-radius: 2dp;
    background-color: #00000080;
    font-effect: outline(1px #000000c0);
}

.price {
    display: block;
    height: 12dp;
    line-height: 12dp;
    text-align: center;
    white-space: nowrap;
    font-size: 9dp;
    font-weight: bold;
    color: #ffe070;
    font-effect: shadow(1px 1px #000000);
}
/* What they pay you: green, as the shop's earnings. */
.price.pay { color: #9ad870; }
/* More than you have. */
.price.dear { color: #ff6a5a; }

/* Your zuly. */
.footer {
    display: flex;
    flex-direction: row;
    align-items: center;
    height: 22dp;
    margin-top: 4dp;
    padding: 0dp 3dp;
}
.coin {
    width: 9dp;
    height: 9dp;
    margin-right: 6dp;
    border: 1dp #a07818ff;
    border-radius: 5dp;
    background-color: #e0b030ff;
    decorator: ui-gloss-soft;
}
.mlabel {
    flex-grow: 1;
    font-size: 10dp;
}
.mval {
    font-weight: bold;
    color: #ffe070;
}

.hint {
    margin-top: 2dp;
    padding: 0dp 2dp;
    font-size: 9dp;
    line-height: 12dp;
}
