/* UI2 message box -- LAYOUT ONLY ( colours and materials: rose-theme.rcss ).
   Reload in game with /uireload. */

/* Over every window: a click on one pulls its document to the front, which
   would otherwise bury the question ( the quantity popup sits at 40 ). */
body { z-index: 50; }

/* Default spot: upper middle of the screen, where an answer is expected. */
#msgbox {
    left: 42%;
    top: 30%;
    width: 280dp;
}

/* Long texts ( the tutorial's notices ) scroll rather than grow off screen. */
.text {
    max-height: 300dp;
    overflow-y: auto;
    padding: 6dp 6dp 8dp 6dp;
    line-height: 16dp;
}
/* {B} in the tutorial's markup. */
.text .b { font-weight: bold; }

/* A notice's countdown: drains to nothing, then the box closes. */
.timer {
    height: 4dp;
    margin: 0dp 4dp 8dp 4dp;
}

.buttons {
    display: flex;
    flex-direction: row;
    justify-content: center;
    margin-bottom: 2dp;
}
.answer {
    box-sizing: border-box;
    width: 100dp;
    height: 22dp;
    padding-left: 0dp;
    padding-right: 0dp;
}
.answer + .answer { margin-left: 8dp; }

/* The bar is full width and shrinks from the right by the bound scaleX: a
   changing width would re-lay out the window every frame. */
.timer .fill {
    right: 0dp;
    transform-origin: 0% 50%;
}

/* Items gained ( RoseRmlUi::ItemsBox: what breaking an item down gave ):
   one row each, the icon at its native 40x40, the name, how many. Rows are
   blocks with the icon pinned absolutely -- not flex ( see shop.rcss on
   nested flex ), and not a float: RmlUi puts a block that follows a float
   below it, not beside it. */
.gains {
    margin-top: 6dp;
}
.gain {
    position: relative;
    height: 44dp;
    margin-bottom: 2dp;
}
.gcell {
    position: absolute;
    left: 0dp;
    top: 0dp;
    display: block;
    box-sizing: border-box;
    width: 42dp;
    height: 42dp;
}
.gname {
    display: block;
    margin-left: 50dp;
    padding-top: 6dp;
    line-height: 14dp;
    font-weight: bold;
    color: #f0f0f0;
}
.gcount {
    display: block;
    margin-left: 50dp;
    line-height: 14dp;
    font-size: 10dp;
    color: #ffe070;
}
