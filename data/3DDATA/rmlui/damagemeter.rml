<rml>
<head>
    <title>Damage Meter</title>
    <link type="text/rcss" href="damagemeter.rcss"/>
</head>
<body data-model="damage_meter">
    <!--
        Rows are generated by data-for from the bound model; nothing on the C++
        side creates or positions an element. <handle move_target> gives the
        panel drag-to-move with no C++ at all.

        No image files are used anywhere in this skin - the caption bar, bevels
        and bars are gradients, and the rounded corners are tessellated by RmlUi.
    -->
    <div id="meter">
        <handle move_target="meter" class="titlebar">
            <span class="title">ROSE Online - {{title}}</span>
            <span class="titlebtn" data-event-click="close_panel()">X</span>
        </handle>

        <div class="infobar">
            <span class="info-left">Running combat timer: {{fight}}</span>
            <span class="info-right">Total Party DPS: {{party_dps}}</span>
        </div>

        <div class="colheads">
            <span class="ch-rank"></span>
            <span class="ch-name"></span>
            <span class="ch-dps">DPS</span>
            <span class="ch-dmg">Total DMG</span>
            <span class="ch-pct">% Contribution</span>
        </div>

        <div class="rows">
            <div class="row" data-for="row : rows"
                 data-class-p1="row.place == 1"
                 data-class-p2="row.place == 2"
                 data-class-p3="row.place == 3"
                 data-class-p4="row.place > 3"
                 data-class-self="row.self">
                <span class="rank">{{row.rank}}</span>
                <span class="name">{{row.name}}</span>
                <div class="track">
                    <div class="fill" data-style-width="row.width + '%'"></div>
                    <span class="dps">{{row.dps}}</span>
                    <span class="dmg">{{row.dmg}}</span>
                    <span class="pct">{{row.pct}}</span>
                </div>
            </div>
        </div>

        <div class="statusline">{{footer}}</div>

        <div class="footer">
            <span class="btn" data-event-click="reset_data()">[Reset]</span>
            <span class="btn" data-event-click="cycle_view()">[Details]</span>
            <span class="btn" data-event-click="close_panel()">[Close]</span>
        </div>
    </div>
</body>
</rml>
