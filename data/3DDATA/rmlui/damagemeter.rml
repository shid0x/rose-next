<rml>
<head>
    <title>Damage Meter</title>
    <link type="text/rcss" href="damagemeter.rcss"/>
</head>
<body data-model="damage_meter">
    <!--
        Rows are generated by data-for from the bound model - the C++ side never
        creates or positions an element. Compare CDamageMeterPanel::Draw(), where
        every row offset is computed by hand.

        <handle move_target> gives the whole panel drag-to-move with no C++ at
        all, replacing the WM_LBUTTONDOWN/WM_MOUSEMOVE drag code in
        CGameStateMain::ProcWndMsgInstant.
    -->
    <div id="meter">
        <handle move_target="meter" class="header">
            <span class="title">DPS - {{title}}</span>
            <span class="btn" data-event-click="cycle_view()">&gt;</span>
            <span class="btn" data-event-click="reset_data()">R</span>
            <span class="btn" data-event-click="close_panel()">X</span>
        </handle>

        <div class="info">
            <span class="fight">{{fight}}</span>
            <span data-class-live="live" data-class-idle="!live">
                {{ live ? 'LIVE' : 'ended' }}
            </span>
        </div>

        <div class="rows">
            <div class="row" data-for="row : rows" data-class-self="row.self">
                <div class="bar" data-style-width="row.pct + '%'"></div>
                <span class="name">{{row.name}}</span>
                <span class="value">{{row.value}}</span>
            </div>
        </div>

        <div class="footer">{{footer}}</div>
    </div>
</body>
</rml>
