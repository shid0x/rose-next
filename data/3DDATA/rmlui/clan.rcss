/* UI2 clan window -- LAYOUT ONLY ( colours and materials: rose-theme.rcss,
   plus the few colours that are this window's own states ).
   Reload in game with /uireload. The C++ places it left of the middle the
   first time, until it is moved.

   PERFORMANCE ( see shop.rcss ): definite width, rows are positioned blocks
   with their columns pinned absolutely, flex only for the small rows. The
   tab pages stay in the document ( display: none while hidden ): the notice
   editor must exist before its tab is shown. Rows are never removed, only
   hidden. */

#clan {
    left: 300dp;
    top: 160dp;
    display: block;
    width: 440dp;
}

.hide { display: none; }

/* --- not in a clan ------------------------------------------------------- */
.noclan {
    padding: 12dp 10dp;
}
.nctitle {
    display: block;
    margin-bottom: 6dp;
    font-weight: bold;
    color: #f0f0f0;
}
.nctext {
    display: block;
    font-size: 10dp;
    line-height: 14dp;
}

/* --- tabs ------------------------------------------------------------------ */
.tabs {
    display: flex;
    flex-direction: row;
    margin-bottom: 5dp;
}
.tab {
    flex: 1;
    font-size: 10dp;
}
.tab + .tab { margin-left: 3dp; }
.page { display: block; }
.page.hide { display: none; }

/* --- info ------------------------------------------------------------------ */

/* The emblem, the name and the slogan. */
.head {
    position: relative;
    height: 52dp;
    margin-bottom: 4dp;
}
.emblem {
    position: absolute;
    left: 6dp;
    top: 5dp;
    width: 40dp;
    height: 40dp;
    border-radius: 3dp;
    background-color: #00000060;
}
/* The two sprites stacked ( back, then symbol ), or the clan's own bitmap. */
.emblem img {
    position: absolute;
    left: 0dp;
    top: 0dp;
    width: 40dp;
    height: 40dp;
}
.htext {
    margin-left: 56dp;
    padding-top: 7dp;
    padding-right: 6dp;
}
.cname {
    display: block;
    line-height: 18dp;
    font-size: 14dp;
    font-weight: bold;
    color: #ffe070;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
.slogan {
    display: block;
    line-height: 14dp;
    font-size: 10dp;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* The numbers: label pinned left, value after it. */
.facts {
    padding: 4dp 0dp;
    margin-bottom: 4dp;
}
.kv {
    position: relative;
    height: 18dp;
}
.k {
    position: absolute;
    left: 10dp;
    top: 0dp;
    line-height: 18dp;
    font-size: 10dp;
}
.v {
    display: block;
    margin-left: 110dp;
    line-height: 18dp;
    color: #f0f0f0;
}

/* Your rank and contribution. */
.me {
    position: relative;
    height: 50dp;
    margin-bottom: 6dp;
}
/* The rank badge at its native size ( about 40 px ), pinned top-left. */
.badge {
    position: absolute;
    left: 6dp;
    top: 4dp;
    width: 42dp;
    height: 42dp;
}
.metext {
    margin-left: 58dp;
    padding-top: 8dp;
    font-size: 10dp;
    line-height: 16dp;
}
.myrank {
    display: block;
    font-size: 12dp;
    font-weight: bold;
    color: #f0f0f0;
}
.myrank.penalty { color: #ff6a50; }

/* The custom mark: its preview beside the explanation and the buttons. */
.markhead {
    margin: 0dp 0dp 3dp 0dp;
    padding: 0dp 2dp;
    font-size: 9dp;
}
.markbox {
    position: relative;
    height: 62dp;
}
.mpreview {
    position: absolute;
    left: 6dp;
    top: 10dp;
    width: 40dp;
    height: 40dp;
    border-radius: 3dp;
    background-color: #00000060;
}
.mpreview img {
    position: absolute;
    left: 0dp;
    top: 0dp;
    width: 40dp;
    height: 40dp;
}
.mtext {
    margin-left: 56dp;
    padding-top: 5dp;
    padding-right: 6dp;
    font-size: 10dp;
    line-height: 13dp;
}
.mbuttons {
    display: flex;
    flex-direction: row;
    margin-top: 5dp;
}
.mbtn {
    width: 76dp;
    margin-right: 4dp;
    box-sizing: border-box;
    padding-left: 0dp;
    padding-right: 0dp;
}

/* --- members --------------------------------------------------------------- */

/* Columns: the name after the light, then rank, level, job, and the
   contribution pinned right. The header row uses the same classes. */
.c-name, .c-rank, .c-lv, .c-job, .c-pts {
    position: absolute;
    top: 0dp;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
/* Room is left on the right for the list's scrollbar. */
.c-name { left: 20dp; width: 112dp; }
.c-rank { left: 136dp; width: 80dp; }
.c-lv   { left: 220dp; width: 26dp; }
.c-job  { left: 250dp; width: 76dp; }
.c-pts  { right: 14dp; width: 64dp; text-align: right; }

.cols {
    position: relative;
    height: 14dp;
    margin-bottom: 2dp;
    font-size: 9dp;
    line-height: 14dp;
}
/* The list's padding, so the header lines up with the rows. */
.cols span { margin-left: 3dp; }

.list {
    height: 260dp;
    overflow-y: auto;
    padding: 3dp;
}
.member {
    position: relative;
    height: 20dp;
    margin-bottom: 1dp;
    border-radius: 3dp;
    line-height: 20dp;
    font-size: 10dp;
    color: #d8d8d8;
    cursor: pointer;
}
.member.unused { display: none; }
.member:hover { background-color: #ffffff12; }
.member.on { background-color: #7a220660; }
.member .c-name { color: #f0f0f0; }
.member.me .c-name { color: #ffe070; }
.member.on .c-name { font-weight: bold; color: #ffffff; }
.member.offline, .member.offline .c-name { color: #7a7a7a; }
.member.penalty .c-rank { color: #ff6a50; }

/* Online / offline light, at the start of the row. */
.dot {
    position: absolute;
    left: 6dp;
    top: 6dp;
    width: 8dp;
    height: 8dp;
    border-radius: 4dp;
    background-color: #6ad04aff;
}
.member.offline .dot { background-color: #5a5a5aff; }

.foot {
    height: 18dp;
    margin-top: 3dp;
}
.count {
    display: block;
    padding-left: 3dp;
    line-height: 18dp;
    font-size: 10dp;
}

/* The buttons: one row of fixed-width floats in a flow-root box. */
.actions {
    display: flow-root;
}
.abtn {
    float: left;
    display: block;
    width: 71dp;
    margin-right: 2dp;
    box-sizing: border-box;
    padding-left: 0dp;
    padding-right: 0dp;
    font-size: 10dp;
}
/* Not possible for the selected member: dimmed, and it does not light up
   ( a click still says why ). */
.abtn.off { color: #909090; }
.abtn.off:hover {
    background-color: #3a3a3aff;
    border-color: #565656ff;
}

/* --- skills ---------------------------------------------------------------- */
.slist {
    height: 300dp;
    overflow-y: auto;
    padding: 3dp;
}
.card {
    position: relative;
    height: 46dp;
    margin-bottom: 2dp;
    border-radius: 3dp;
}
.card.unused { display: none; }
.card:hover { background-color: #ffffff12; }

/* Native-size icon pinned top-left, as on the skill bar and the skill window. */
.icon {
    position: absolute;
    left: 2dp;
    top: 2dp;
    box-sizing: border-box;
    width: 42dp;
    height: 42dp;
    align-items: flex-start;
    justify-content: flex-start;
    cursor: pointer;
}
.card.passive .icon { cursor: default; }
.cd {
    position: absolute;
    left: 1dp;
    right: 1dp;
    top: 1dp;
    bottom: 1dp;
    border-radius: 3dp;
    background-color: #000000b0;
    transform-origin: 50% 100%;
}
.sinfo {
    margin-left: 52dp;
    padding-top: 3dp;
    font-size: 10dp;
    line-height: 13dp;
}
.sname {
    display: block;
    font-size: 11dp;
    font-weight: bold;
    color: #f0f0f0;
}
.sinfo span { display: block; }

.hint {
    margin-top: 3dp;
    padding: 0dp 2dp;
    font-size: 9dp;
    line-height: 12dp;
}

.empty {
    padding: 8dp 4dp;
    font-size: 10dp;
    line-height: 14dp;
}

/* --- notice ---------------------------------------------------------------- */
.nview {
    height: 300dp;
    overflow-y: auto;
    padding: 6dp 8dp;
}
.nview.hide { display: none; }
.ntext {
    color: #f0f0f0;
    line-height: 16dp;
}
.nedit { display: block; }
.nedit.hide { display: none; }
.noticeedit {
    display: block;
    width: 100%;
    height: 314dp;
    white-space: pre-wrap;
}
.nbuttons {
    display: flow-root;
    margin-top: 4dp;
}
.nbtn {
    float: right;
    display: block;
    width: 70dp;
    margin-left: 4dp;
    box-sizing: border-box;
    padding-left: 0dp;
    padding-right: 0dp;
}
