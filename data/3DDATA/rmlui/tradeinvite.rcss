/* UI2 trade request -- LAYOUT ONLY ( colours and materials: rose-theme.rcss ).
   Reload in game with /uireload. */

/* Over the windows ( a click on one pulls its document to the front ); the
   quantity popup is at 40, the message box at 50. */
body { z-index: 45; }

/* Default spot: upper middle of the screen, under the party invitation's. */
#tradeinvite {
    left: 42%;
    top: 34%;
    width: 260dp;
}

.secs {
    margin-right: 4dp;
    font-size: 10dp;
}

.msg {
    padding: 6dp 6dp 8dp 6dp;
    line-height: 16dp;
}
.who {
    font-weight: bold;
    color: #ff9a5a;
}

/* The countdown: drains to nothing, then the request is declined. Full
   width, shrunk from the right by the bound scaleX. */
.timer {
    height: 4dp;
    margin: 0dp 4dp 8dp 4dp;
}
.timer .fill {
    right: 0dp;
    transform-origin: 0% 50%;
}

.buttons {
    display: flex;
    flex-direction: row;
    justify-content: center;
    margin-bottom: 2dp;
}
.answer {
    box-sizing: border-box;
    width: 100dp;
    height: 22dp;
    padding-left: 0dp;
    padding-right: 0dp;
}
.answer + .answer { margin-left: 8dp; }
