/* UI2 skill window -- LAYOUT ONLY ( colours and materials: rose-theme.rcss,
   plus the few colours that are this window's own states ).
   Reload in game with /uireload. */

#skills {
    left: 560dp;
    top: 120dp;
    width: 320dp;
}

/* Skill points, in the title bar. */
.sp {
    margin-right: 8dp;
    font-weight: bold;
    color: #ff9a5a;
    font-effect: shadow(1px 1px #000000c0);
}

/* --- tabs: a segmented row of the theme's buttons ------------------------ */
.tabs {
    display: flex;
    flex-direction: row;
    margin-bottom: 4dp;
}
.tab {
    flex: 1;
    margin-right: 3dp;
    padding-left: 0dp;
    padding-right: 0dp;
}
.tab:last-child { margin-right: 0dp; }
.tab .n {
    margin-left: 5dp;
    font-weight: normal;
    color: #9a9a9a;
}
.tab.on .n { color: #ffd2b8; }

/* --- the list ---------------------------------------------------------------- */
.list {
    height: 330dp;
    overflow-y: auto;
    padding: 3dp;
}
.empty {
    padding-top: 20dp;
    text-align: center;
}

.card {
    display: flex;
    flex-direction: row;
    align-items: center;
    height: 42dp;
    padding: 3dp;
    margin-bottom: 3dp;
    border: 1dp #ffffff10;
    border-radius: 3dp;
    background-color: #ffffff08;
}
.card:hover {
    background-color: #ffffff14;
    border-color: #d0501a80;
}

/* Native-size icon pinned top-left, as on the skill bar ( skill sprites are
   39x39: centring one in a 40 px box puts it on a half pixel and blurs it ). */
.icon {
    position: relative;
    box-sizing: border-box;
    width: 42dp;
    height: 42dp;
    align-items: flex-start;
    justify-content: flex-start;
    cursor: pointer;
}
.card.passive .icon { cursor: default; }

.cd {
    position: absolute;
    left: 1dp;
    right: 1dp;
    bottom: 1dp;
    border-radius: 3dp;
    background-color: #000000b0;
}

/* --- name, level, costs ---------------------------------------------------- */
.info {
    flex-grow: 1;
    margin-left: 8dp;
    overflow: hidden;
}
.line1 {
    display: flex;
    flex-direction: row;
}
.name {
    flex-grow: 1;
    font-weight: bold;
    color: #f0f0f0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
.lv {
    margin-left: 6dp;
    font-size: 10dp;
    font-weight: bold;
    color: #ff9a5a;
}
.lv .of { font-weight: normal; color: #9a9a9a; }

/* Level out of the line's maximum: a thin gold bar, its fill an in-flow
   block with a percentage width. */
.lvbar {
    height: 4dp;
    margin-top: 3dp;
    margin-bottom: 3dp;
    border-radius: 2dp;
    background-color: #00000080;
}
.lvfill {
    height: 4dp;
    border-radius: 2dp;
    background-color: #c8a030ff;
    decorator: ui-gloss-soft;
}

.costs {
    font-size: 10dp;
    white-space: nowrap;
}

/* --- level up ---------------------------------------------------------------- */
.up {
    width: 44dp;
    margin-left: 6dp;
    display: flex;
    flex-direction: column;
    align-items: center;
}
.plus {
    width: 22dp;
    height: 20dp;
    line-height: 18dp;
    text-align: center;
    font-size: 15dp;
    font-weight: bold;
    color: #5a5a5a;
    border: 1dp #3a3a3aff;
    border-radius: 3dp;
    background-color: #262626ff;
    decorator: ui-gloss-soft;
}
/* Live: you can level it now -- ember glass, like every active button. */
.plus.live {
    color: #ffffff;
    border-color: #d0501aff;
    background-color: #922500ff;
    decorator: ui-gloss;
    cursor: pointer;
    font-effect: shadow(1px 1px #00000090);
}
.plus.live:hover { background-color: #b0360eff; }

.upcost {
    margin-top: 2dp;
    font-size: 9dp;
    color: #9a9a9a;
}
.upcost.short { color: #ff6a5a; }

/* --- footer ------------------------------------------------------------------- */
.footer {
    display: flex;
    flex-direction: row;
    align-items: center;
    margin-top: 4dp;
}
.hint {
    flex-grow: 1;
    padding-left: 2dp;
    font-size: 9dp;
}
.tree { font-size: 10dp; }
