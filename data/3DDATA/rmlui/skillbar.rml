<rml>
<head>
    <title>Skill Bar</title>
    <!-- Theme first ( materials, colours, states ), then this panel's layout. -->
    <link type="text/rcss" href="rose-theme.rcss"/>
    <link type="text/rcss" href="skillbar.rcss"/>
</head>
<body data-model="skillbar">
    <!--
        UI2 skill bar ( RoseRmlSkillBar ): a view of the two legacy quickbars,
        which stay alive hidden and keep the hotkeys and the page.

        Each row declares the legacy dialog type a drop on it stands for
        ( drop-target ): RoseRmlUi ends a legacy drag there, and the legacy
        drop command then asks for the slot under the mouse ( slot ).

        Slots: click to use, press and drag to move ( drop on the ground to
        remove ). The grip on the left moves the bar.
    -->
    <!-- .vertical ( Interface window ) turns the rows into columns. -->
    <div id="skillbar" class="ui-window" data-class-vertical="vertical">
        <handle move_target="skillbar" class="grip"></handle>

        <div class="rows">
            <div class="row" data-attr-drop-target="main_type">
                <div class="pager">
                    <span class="page ui-accent">{{main_page}}</span>
                    <div class="arrows">
                        <span class="arrow" data-event-click="page(0, -1)">&#8249;</span>
                        <span class="arrow" data-event-click="page(0, 1)">&#8250;</span>
                    </div>
                </div>
                <div class="slot ui-icon" data-for="s : main" data-attr-slot="s.index"
                     data-class-empty="!s.filled" data-class-off="s.off"
                     data-event-mousedown="press(s.index)" data-event-click="use(s.index)">
                    <img data-if="s.filled" data-attr-src="s.src" data-attr-rect="s.rect"/>
                    <div class="cd" data-if="s.cd > 0" data-style-height="s.cd + '%'"></div>
                    <span class="cd-text" data-if="s.cd_text != ''">{{s.cd_text}}</span>
                    <span class="count" data-if="s.count > 0">{{s.count}}</span>
                    <span class="key">{{s.key}}</span>
                </div>
            </div>

            <div class="row" data-attr-drop-target="ext_type">
                <div class="pager">
                    <span class="page ui-accent">{{ext_page}}</span>
                    <div class="arrows">
                        <span class="arrow" data-event-click="page(1, -1)">&#8249;</span>
                        <span class="arrow" data-event-click="page(1, 1)">&#8250;</span>
                    </div>
                </div>
                <div class="slot ui-icon" data-for="s : ext" data-attr-slot="s.index"
                     data-class-empty="!s.filled" data-class-off="s.off"
                     data-event-mousedown="press(s.index)" data-event-click="use(s.index)">
                    <img data-if="s.filled" data-attr-src="s.src" data-attr-rect="s.rect"/>
                    <div class="cd" data-if="s.cd > 0" data-style-height="s.cd + '%'"></div>
                    <span class="cd-text" data-if="s.cd_text != ''">{{s.cd_text}}</span>
                    <span class="count" data-if="s.count > 0">{{s.count}}</span>
                    <span class="key">{{s.key}}</span>
                </div>
            </div>
        </div>
    </div>
</body>
</rml>
