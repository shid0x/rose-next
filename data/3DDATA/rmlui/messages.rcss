/* UI2 private messages -- LAYOUT ONLY ( colours and materials: rose-theme.rcss,
   plus the few colours that are this window's own states ).
   Reload in game with /uireload. The C++ places it left of the friends
   window the first time, until it is moved.

   PERFORMANCE ( see shop.rcss ): definite width, the tabs are fixed-size
   floats, the lines are plain blocks of inline text; tabs and lines are
   never removed, only hidden. */

#messages {
    left: 300dp;
    top: 200dp;
    display: block;
    width: 330dp;
}

/* One tab per conversation: a light, the name, and x. */
.tabs {
    display: flow-root;
    margin-bottom: 4dp;
}
.tab {
    float: left;
    display: block;
    position: relative;
    box-sizing: border-box;
    width: 104dp;
    height: 22dp;
    line-height: 21dp;
    margin: 0dp 3dp 3dp 0dp;
    padding-left: 18dp;
    padding-right: 16dp;
    font-size: 10dp;
    text-align: left;
}
.tab.unused { display: none; }
.tname {
    display: block;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
.tdot {
    position: absolute;
    left: 6dp;
    top: 7dp;
    width: 7dp;
    height: 7dp;
    border-radius: 4dp;
    background-color: #6ad04aff;
}
.tab.offline .tdot { background-color: #5a5a5aff; }
.tx {
    position: absolute;
    right: 4dp;
    top: 0dp;
    width: 10dp;
    text-align: center;
    color: #b0b0b0;
}
.tx:hover { color: #ffffff; }

/* Unread messages in a tab behind: it pulses ember until opened. */
@keyframes msg-unread {
    from { background-color: #3a3a3aff; border-color: #565656ff; }
    to   { background-color: #b0360eff; border-color: #e0602aff; }
}
.tab.unread { animation: 0.6s quadratic-in-out infinite alternate msg-unread; }

/* Who, and their state now. */
.with {
    display: flow-root;
    height: 16dp;
    line-height: 16dp;
    margin-bottom: 3dp;
    padding: 0dp 3dp;
}
.wname { font-weight: bold; color: #f0f0f0; }
.wstate {
    margin-left: 6dp;
    font-size: 10dp;
    color: #9ad870;
}
.wstate.offline { color: #8a8a8a; }

/* The conversation. */
.log {
    height: 220dp;
    overflow-y: auto;
    padding: 4dp 5dp;
}
.line {
    display: block;
    margin-bottom: 2dp;
    line-height: 15dp;
}
.line.unused { display: none; }
.who { font-weight: bold; color: #ffb070; }
.line.mine .who { color: #9ad870; }
.txt { color: #e6e6e6; }
.line.note .txt { color: #ff9a8a; font-size: 10dp; }
.empty {
    padding: 6dp 2dp;
    font-size: 10dp;
}

.sayrow {
    display: flex;
    flex-direction: row;
    align-items: center;
    height: 26dp;
    margin-top: 4dp;
}
.say { width: 260dp; }
.sendbtn {
    margin-left: 6dp;
    width: 54dp;
    box-sizing: border-box;
    padding-left: 0dp;
    padding-right: 0dp;
}
