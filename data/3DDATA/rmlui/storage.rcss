/* UI2 storage -- LAYOUT ONLY ( colours and materials: rose-theme.rcss, plus
   the few colours that are this window's own states ).
   Reload in game with /uireload. The C++ places it beside the bag the first
   time, until it is moved.

   PERFORMANCE ( see shop.rcss ): the grid is fixed-size floats, the window
   has a definite width, flex only for the small rows. Eight cells of 42 + 2
   = 352, 1 of slack, the well's 4 of padding and 2 of border: 359. */

#storage {
    left: 60dp;
    top: 160dp;
    display: block;
    width: 359dp;
}

/* The four tabs, each with how many slots are used. */
.tabs {
    display: flex;
    flex-direction: row;
    margin-bottom: 4dp;
}
.tab {
    flex: 1;
    padding-left: 4dp;
    padding-right: 4dp;
    font-size: 10dp;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
.tab + .tab { margin-left: 3dp; }
.tab .n {
    margin-left: 4dp;
    font-weight: normal;
    color: #9a9a9a;
}
.tab.on .n { color: #ffd2b8; }

.grid {
    display: flow-root;
    width: 353dp;
    padding: 3dp 1dp 1dp 3dp;
}

/* .ui-icon ( theme ) is the dark backing square, a flex box that centres;
   here a plain block with the icon pinned top-left at its NATIVE atlas size
   ( 40x40 ), as in the bag. No width/height on the img. */
.cell {
    float: left;
    display: block;
    position: relative;
    box-sizing: border-box;
    width: 42dp;
    height: 42dp;
    margin-right: 2dp;
    margin-bottom: 2dp;
    cursor: pointer;
}
.cell:hover { border-color: #d0501aff; }
.cell.empty { background-color: #00000050; cursor: default; }
.cell.empty:hover { border-color: #000000c0; }

.gem {
    position: absolute;
    left: 0dp;
    top: 0dp;
}
.socket {
    position: absolute;
    left: 0dp;
    top: 0dp;
}

/* How many, top left, where the classic icon drew it. */
.count {
    position: absolute;
    left: 1dp;
    top: 1dp;
    padding: 0dp 2dp;
    line-height: 12dp;
    font-size: 10dp;
    font-weight: bold;
    color: #ffffff;
    border-radius: 2dp;
    background-color: #00000080;
    font-effect: outline(1px #000000c0);
}

/* The Platinum tab, for someone who is not: why a deposit is refused. */
.note {
    margin-top: 4dp;
    padding: 4dp 6dp;
    border: 1dp #8a6a20ff;
    border-radius: 3dp;
    background-color: #3a2a08c0;
    font-size: 9dp;
    line-height: 12dp;
    color: #ffe0a0;
}

/* The stored zuly and the two ways to move it. */
.footer {
    display: flex;
    flex-direction: row;
    align-items: center;
    height: 26dp;
    margin-top: 4dp;
    padding: 0dp 3dp;
}
.coin {
    width: 9dp;
    height: 9dp;
    margin-right: 6dp;
    border: 1dp #a07818ff;
    border-radius: 5dp;
    background-color: #e0b030ff;
    decorator: ui-gloss-soft;
}
.mval {
    flex-grow: 1;
    font-weight: bold;
    color: #ffe070;
}
.mbtn {
    height: 20dp;
    line-height: 19dp;
    padding-left: 10dp;
    padding-right: 10dp;
    font-size: 10dp;
}
.mbtn + .mbtn { margin-left: 4dp; }

.hint {
    margin-top: 3dp;
    padding: 0dp 2dp;
    font-size: 9dp;
    line-height: 12dp;
}
