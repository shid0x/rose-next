<rml>
<head>
    <title>Message</title>
    <!-- Theme first ( materials, colours, states ), then this panel's layout. -->
    <link type="text/rcss" href="rose-theme.rcss"/>
    <link type="text/rcss" href="msgbox.rcss"/>
</head>
<body data-model="msgbox">
    <!--
        UI2 message box ( RoseRmlMessageBox ): every popup UI2 shows -- a
        notice that closes itself when its bar runs out, a question with two
        named answers, an OK that runs something, a request from another
        player ( declined when its bar runs out ), the death window, the
        logout countdown. Drag the title bar to move it; the spot is saved.
    -->
    <div id="msgbox" class="ui-window">
        <handle move_target="msgbox" class="ui-titlebar">
            <span class="ui-title">{{title}}</span>
        </handle>

        <!-- RML: plain text arrives escaped, the tutorial's markup converted. -->
        <div class="text" data-rml="text"></div>

        <div class="timer ui-gauge" data-if="timed"><div class="ui-gauge-fill steel fill" data-style-transform="'scaleX(' + (time_left + 0.1) / 100 + ')'"></div></div>

        <div class="buttons">
            <span class="ui-btn answer" data-event-click="answer(true)">{{ok}}</span>
            <span class="ui-btn answer" data-if="!single" data-event-click="answer(false)">{{cancel}}</span>
        </div>
    </div>
</body>
</rml>
