/* UI2 buff bar -- LAYOUT ONLY ( colours and materials: rose-theme.rcss ).
   Reload in game with /uireload. */

/* RoseRmlBuffBar moves this under the status panel every frame; left/top
   here only matter for the first frame. */
#buffs {
    position: absolute;
    left: 3dp;
    top: 110dp;
    width: 250dp;              /* icons wrap after ten */
}

/* --- icons ------------------------------------------------------------------ */
.icons {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
}

/* Each buff is a .ui-tipped element ( rose-theme.rcss ); see there for why it
   must not be position: relative. */
.buff {
    width: 24dp;
    margin-right: 3dp;
    margin-bottom: 2dp;
}

/* The backing square ( .ui-icon ) is a little larger than the icon. */
.frame {
    width: 24dp;
    height: 24dp;
}
.frame img {
    width: 20dp;
    height: 20dp;
}

/* Remaining time, under the icon. */
.time {
    display: block;
    text-align: center;
    font-size: 9dp;
    color: #e6e6e6;
    font-effect: outline(1px #000000c0);
}

.buff.ui-blink .time { color: #ff9a5a; }

.worn { margin-top: 3dp; }

/* --- summon / fuel gauges ------------------------------------------------- */
.mini {
    display: flex;
    flex-direction: row;
    align-items: center;
    width: 180dp;
    margin-top: 3dp;
}

.mini-label {
    width: 70dp;
    font-size: 10dp;
    font-effect: outline(1px #000000c0);
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.mini-bar {
    flex-grow: 1;
    height: 13dp;
    display: flex;
    align-items: center;
    justify-content: center;
}

.mini-text { font-size: 9dp; }
