/* Damage meter skin — light "ROSE dialog" theme.

   Uses NO image files. Everything here is gradients, borders, rounded corners
   and flexbox, so the whole look can be changed by editing this file and
   restarting. Bevels are just two gradients plus a light/dark border pair.

   Supported by the D3D9 backend: linear-gradient (any angle, repeating),
   border-radius, borders, flexbox, :hover/:active, transitions, font-effect,
   overflow/scrolling, and images from loose files.
   NOT supported — avoid: radial/conic gradients, blurred box-shadow, filter,
   backdrop-filter, transform (rotate/scale). They warn or do nothing. */

body {
    font-family: Verdana;      /* the client's own UI font */
    font-size: 11px;
}

/* --- window -------------------------------------------------------------- */
#meter {
    position: absolute;
    left: 40px;
    top: 180px;
    width: 430px;

    display: flex;
    flex-direction: column;

    padding: 5px;
    border: 2px #6a78b4ff;
    border-radius: 6px;
    decorator: linear-gradient(to bottom, #ccd0f0ff, #b4bce4ff);
}

/* --- title bar ----------------------------------------------------------- */
.titlebar {
    display: flex;
    flex-direction: row;
    align-items: center;
    height: 26px;
    padding-left: 8px;
    padding-right: 4px;
    margin-bottom: 5px;
    border: 1px #4c3c7cff;
    border-radius: 4px;
    cursor: move;
    decorator: linear-gradient(to bottom, #9a7ed2ff, #6a4ea6ff);
}

.title {
    flex-grow: 1;
    font-size: 13px;
    font-weight: bold;
    color: #ffffff;
}

.titlebtn {
    width: 18px;
    height: 18px;
    text-align: center;
    font-weight: bold;
    color: #a01414ff;
    border: 1px #4c3c7cff;
    border-radius: 3px;
    decorator: linear-gradient(to bottom, #ffffffff, #d2d2e6ff);
}

.titlebtn:hover  { color: #ff0000ff; }
.titlebtn:active { decorator: linear-gradient(to bottom, #c8c8dcff, #ffffffff); }

/* --- info bar: inset panel ----------------------------------------------- */
.infobar {
    display: flex;
    flex-direction: row;
    height: 22px;
    align-items: center;
    padding-left: 8px;
    padding-right: 8px;
    margin-bottom: 5px;

    font-size: 10px;           /* both labels have to share 430px */
    font-weight: bold;
    color: #28327cff;
    border: 1px #8290c8ff;
    border-radius: 3px;
    /* inset = dark at top, light at bottom (opposite of a raised bevel) */
    decorator: linear-gradient(to bottom, #aab4e0ff, #dce0f8ff);
}

.info-left  { flex-grow: 1; }
.info-right { text-align: right; }

/* --- column headings ------------------------------------------------------ */
.colheads {
    display: flex;
    flex-direction: row;
    height: 18px;
    align-items: center;
    padding-left: 4px;
    padding-right: 4px;
    font-weight: bold;
    color: #28327cff;
}

.ch-rank { width: 44px; }
.ch-name { width: 84px; }
.ch-dps  { width: 96px; text-align: right; }
.ch-dmg  { width: 96px; text-align: right; }
.ch-pct  { flex-grow: 1; text-align: right; }

/* --- rows: inset well ----------------------------------------------------- */
.rows {
    height: auto;
    max-height: 200px;
    overflow-y: auto;

    padding: 4px;
    border: 1px #8290c8ff;
    border-radius: 4px;
    decorator: linear-gradient(to bottom, #a8b0dcff, #bcc4ecff);
}

.row {
    display: flex;
    flex-direction: row;
    align-items: center;
    height: 34px;
    margin-bottom: 4px;
}

.rank {
    width: 44px;
    font-size: 20px;
    font-weight: bold;
    color: #1e2864ff;
    text-align: center;
}

.name {
    width: 84px;
    font-weight: bold;
    font-effect: outline(1px #00000060);
}

/* --- the bar: dark track, proportional coloured fill ---------------------- */
.track {
    position: relative;
    flex-grow: 1;
    height: 26px;

    display: flex;
    flex-direction: row;
    align-items: center;
    padding-left: 6px;
    padding-right: 6px;

    border: 1px #3c4682ff;
    border-radius: 4px;
    decorator: linear-gradient(to bottom, #3c4682ff, #505a96ff);
}

/* Width comes from the data model; sits behind the text. */
.fill {
    position: absolute;
    left: 0px;
    top: 0px;
    height: 26px;
    border-radius: 3px;
}

.dps { width: 90px; text-align: right; font-weight: bold; color: #ffffffff; }
.dmg { width: 96px; text-align: right; font-weight: bold; color: #dcdcf0ff; }
.pct { flex-grow: 1; text-align: right; font-weight: bold; color: #ffffffff; }

/* --- per-place colours ---------------------------------------------------- */
/* Swap these four gradients to reskin the ranking entirely. */
.row.p1 .fill { decorator: linear-gradient(to bottom, #6ea0e6ff, #3c64b4ff); }
.row.p2 .fill { decorator: linear-gradient(to bottom, #b478d2ff, #7a3ca0ff); }
.row.p3 .fill { decorator: linear-gradient(to bottom, #78c878ff, #3c8c3cff); }
.row.p4 .fill { decorator: linear-gradient(to bottom, #e67878ff, #b43c3cff); }

.row.p1 .name { color: #dc5a3cff; }
.row.p2 .name { color: #e69632ff; }
.row.p3 .name { color: #46a046ff; }
.row.p4 .name { color: #d2508cff; }

/* The avatar's own row, whichever place it is in. */
.row.self .rank { color: #8c1e1eff; }

/* --- status line ---------------------------------------------------------- */
.statusline {
    height: 16px;
    margin-top: 4px;
    padding-left: 4px;
    color: #28327cff;
}

/* --- footer buttons: raised bevel ---------------------------------------- */
.footer {
    display: flex;
    flex-direction: row;
    height: 26px;
    align-items: center;
    margin-top: 2px;
}

.spacer { flex-grow: 1; }

.btn {
    width: 96px;
    height: 22px;
    margin-left: 6px;
    text-align: center;

    font-weight: bold;
    color: #1e2864ff;
    border: 1px #6a78b4ff;
    border-radius: 3px;
    decorator: linear-gradient(to bottom, #eaeafaff, #c2c8e8ff);
    /* RmlUi has no plain "linear" tween -- only linear-in / -out / -in-out.
       Writing `linear` is a parse error and the whole declaration is dropped. */
    transition: color 0.1s linear-in-out;
    cursor: pointer;
}

.btn:hover  { color: #000000ff; decorator: linear-gradient(to bottom, #ffffffff, #d2d8f4ff); }
.btn:active { decorator: linear-gradient(to bottom, #b4bce0ff, #eaeafaff); }
