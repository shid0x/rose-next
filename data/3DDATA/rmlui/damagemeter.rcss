/* Damage meter styling.
   Every value here is a hard-coded constant in the legacy
   src/client/interface/CDamageMeterPanel.cpp (kPanelW, kRowH, kColSelf, ...).
   Edit, restart, see it change - no rebuild.

   Do NOT add filter / backdrop-filter / blurred box-shadow / linear-gradient /
   rotate: the DX9 backend implements only the mandatory renderer features, so
   those silently do nothing or draw wrong. */

body {
    font-family: Verdana;      /* matches the client's own UI font */
    font-size: 11px;

    /* MUST span the viewport. ElementHandle clamps a drag to the move target's
       containing block, which for an absolutely-positioned panel is <body>; if
       body collapses to its content the panel can only be nudged a few pixels
       near the origin. Note RoseRmlUi deliberately does not treat a hover on
       <body> as "over the UI", or this would swallow every click in the game. */
    width: 100%;
    height: 100%;
}

#meter {
    position: absolute;
    left: 16px;
    top: 220px;
    width: 252px;              /* kPanelW */

    display: flex;
    flex-direction: column;

    padding: 8px;              /* kPad */
    border: 1px #3c3c4aff;
    border-radius: 4px;        /* tessellated by RmlUi - needs no renderer support */

    /* Gradients are implemented in the D3D9 backend by baking the colour stops
       into a 1-D ramp and projecting position onto the gradient axis with a
       texture-coordinate transform. Linear only: radial and conic are a
       per-pixel function of distance/angle and will warn and draw nothing. */
    decorator: linear-gradient(to bottom, #1e1e2ee8, #0a0a12e8);
}

/* --- drag area: header + info line --------------------------------------- */
.dragarea {
    display: block;
    cursor: move;
}

/* --- header: title stretches, buttons pin right -------------------------- */
/* Gradient caption bar, in the spirit of the game's own dialogs but with no
   sprite behind it -- edit the two colours and restart to reskin it. */
.header {
    display: flex;
    flex-direction: row;
    align-items: center;
    height: 22px;              /* kHeaderH */
    padding-left: 4px;
    padding-right: 4px;
    border-radius: 3px;
    decorator: linear-gradient(to bottom, #6e5aa0ff, #3c2d64ff);
}

.title {
    flex-grow: 1;              /* replaces all the manual offset arithmetic */
    font-size: 12px;
    font-weight: bold;
    color: #ffffff;
}

.btn {
    width: 18px;               /* kBtnW */
    height: 16px;
    text-align: center;
    color: #c8c8c8;            /* kColBtn */
    cursor: pointer;
}

.btn:hover  { color: #ffffff; background-color: #ffffff20; }
.btn:active { color: #ffd250; }

/* --- info line ------------------------------------------------------------ */
.info {
    display: flex;
    flex-direction: row;
    height: 16px;              /* kInfoH */
    color: #b4b4b4;            /* kColInfo */
}

.fight { flex-grow: 1; }
.live  { color: #78ff6e; }     /* kColLive */
.idle  { color: #a0a0a0; }     /* kColIdle */

/* --- rows ----------------------------------------------------------------- */
/* Sizes to its content so one row does not leave a void, but caps out so a full
   party list clips and scrolls instead of growing the panel off-screen. The cap
   is also what exercises the renderer's scissor path. */
.rows {
    height: auto;
    max-height: 160px;         /* 10 rows * kRowH */
    overflow-y: auto;
}

.row {
    position: relative;
    display: flex;
    flex-direction: row;
    height: 16px;              /* kRowH */
    color: #ebebeb;            /* kColRow */
}

.row.self { color: #ffd250; }  /* kColSelf */

/* Proportional bar behind the text; width comes from the data model.
   The vertical sheen that used to require a gauge sprite is now a gradient. */
.bar {
    position: absolute;
    left: 0px;
    top: 2px;
    height: 12px;
    border-radius: 2px;
    decorator: linear-gradient(to bottom, #e65a5aa0, #a02828a0);
}

.name  { flex-grow: 1; }
.value { text-align: right; }

/* --- footer --------------------------------------------------------------- */
.footer {
    height: 16px;              /* kFooterH */
    color: #b4b4b4;
}
