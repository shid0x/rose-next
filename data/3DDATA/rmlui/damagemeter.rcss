/* Damage meter -- LAYOUT ONLY.

   Colours, bevels, gloss, button states and scrollbars all come from
   rose-theme.rcss, which the document links first. If a rule here starts
   choosing a colour or a gradient, it probably belongs in the theme so the
   next panel gets it too. Reload in game with /uireload. */

/* --- window -------------------------------------------------------------- */
#meter {
    left: 40dp;
    top: 180dp;
    width: 400dp;
}

/* --- info strip ------------------------------------------------------------ */
.infobar {
    display: flex;
    flex-direction: row;
    align-items: center;
    height: 20dp;
    padding-left: 6dp;
    padding-right: 8dp;
    margin-bottom: 4dp;
}

.info-left  { flex-grow: 1; }
.info-right { text-align: right; }

/* A lit pip in front of the timer while a fight is running. The only colour
   rule in this file, because it is this panel's own state, not a material. */
.live-dot {
    width: 6dp;
    height: 6dp;
    margin-right: 6dp;
    border-radius: 3dp;
    background-color: #ffffff20;
}
.live-dot.on { background-color: #ff7a30ff; }

/* --- rows ------------------------------------------------------------------ */
.rows {
    max-height: 244dp;         /* ten rows fit without a scrollbar */
    overflow-y: auto;
    padding: 3dp;
}

.row {
    display: flex;
    flex-direction: row;
    align-items: center;
    height: 22dp;
    margin-bottom: 2dp;
}

.rank {
    width: 30dp;
    text-align: center;
    color: #9a9a9a;
}

.name {
    width: 96dp;
    padding-right: 6dp;
    font-weight: bold;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

/* The avatar's own row, whichever place it is in. */
.row.self .name,
.row.self .rank { color: #ff9a5a; }

/* --- the bar ---------------------------------------------------------------- */
.bar {
    flex-grow: 1;
    height: 18dp;

    display: flex;
    flex-direction: row;
    align-items: center;
    padding-left: 6dp;
    padding-right: 6dp;
}

.dps { width: 92dp; text-align: right; }
.dmg { width: 84dp; text-align: right; color: #d8d8d8; }
.pct { flex-grow: 1; text-align: right; }

/* --- footer ------------------------------------------------------------------ */
.statusline {
    height: 16dp;
    margin-top: 4dp;
    padding-left: 4dp;
}

.footer {
    display: flex;
    flex-direction: row;
    justify-content: center;
    margin-top: 2dp;
    margin-bottom: 1dp;
}

.footer .ui-btn {
    width: 72dp;
    margin-left: 3dp;
    margin-right: 3dp;
}
