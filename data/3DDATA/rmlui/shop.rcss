/* UI2 shop -- LAYOUT ONLY ( colours and materials: rose-theme.rcss, plus the
   few colours that are this window's own states ).
   Reload in game with /uireload. The C++ places it beside the inventory the
   first time, until it is moved.

   PERFORMANCE: the grids are fixed-size FLOATS, not flexbox, and every box
   whose size is known says so. RmlUi re-lays out the whole document on any
   change ( a tab switch, a price ), and it measures each flex item before
   placing it, so flex nested in flex multiplies the work: with the shelf's
   icons five flex levels deep, one tab switch cost 12-25 ms of layout and
   the first open 26 ms. Keep flex to the small rows ( tabs, totals,
   buttons ). */

/* Block, not the theme's flex column, and a definite width: the content is
   laid out once instead of being measured for a shrink-to-fit width. 359 of
   shelf + 8 + 227 of basket. */
#shop {
    left: 60dp;
    top: 160dp;
    display: block;
    width: 594dp;
}

/* The merchant's role after the name, quieter. */
.role {
    margin-right: 8dp;
    font-size: 10dp;
    color: #b0b0b0;
}

/* The shelf on the left, the basket on the right: two floats. */
.columns { display: flow-root; }

/* --- the shelf ---------------------------------------------------------------- */
.shelfcol {
    float: left;
    width: 359dp;
}

/* The merchant's tabs ( up to four, named by the shop ): a segmented row. */
.tabs {
    display: flex;
    flex-direction: row;
    width: 359dp;
    margin-bottom: 4dp;
}
.tab {
    flex: 1;
    padding-left: 4dp;
    padding-right: 4dp;
    font-size: 10dp;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
.tab + .tab { margin-left: 3dp; }

/* Eight items across: 8 x ( 42 + 2 ) = 352, with 1 dp to spare so rounding
   at odd UI scales cannot push the eighth to the next row. Width is the
   CONTENT box: the well's 3 + 1 padding and 1 + 1 border come on top ( 359
   outside ), and the tab row above matches it. */
.shelf {
    display: flow-root;
    width: 353dp;
    padding: 3dp 1dp 0dp 3dp;
}

/* An item: its icon and its price under it, 42 x 54. */
.item {
    float: left;
    width: 42dp;
    height: 54dp;
    margin-right: 2dp;
    margin-bottom: 3dp;
    cursor: pointer;
}
.item.empty { cursor: default; }
.item:hover .cell { border-color: #d0501aff; }
.item.empty:hover .cell { border-color: #000000c0; }

.price {
    display: block;
    height: 12dp;
    line-height: 12dp;
    text-align: center;
    white-space: nowrap;
    font-size: 9dp;
    font-weight: bold;
    color: #ffe070;
    font-effect: shadow(1px 1px #000000);
}
/* More than you have. */
.price.dear { color: #ff6a5a; }

.hint {
    width: 353dp;
    margin-top: 4dp;
    padding: 0dp 2dp;
    font-size: 9dp;
    line-height: 12dp;
}

/* --- icons ( shelf and basket ) ------------------------------------------------- */

/* .ui-icon ( theme ) is the dark backing square, a flex box that centres; here
   it is a plain block -- the icon is pinned top-left at its NATIVE atlas size
   ( 40x40 ) anyway, as in the inventory. No width/height on the img, or it is
   stretched and blurred. */
.cell {
    display: block;
    position: relative;
    box-sizing: border-box;
    width: 42dp;
    height: 42dp;
}
.cart .cell {
    float: left;
    margin-right: 2dp;
    margin-bottom: 2dp;
    cursor: pointer;
}
.cart .cell:hover { border-color: #d0501aff; }
.cell.empty, .item.empty .cell { background-color: #00000050; }
.cart .cell.empty { cursor: default; }
.cart .cell.empty:hover { border-color: #000000c0; }

/* Socket: the gem's mark, or the classic empty-socket overlay, over the item
   image at its native size ( as CIconItem::Draw ). */
.gem {
    position: absolute;
    left: 0dp;
    top: 0dp;
}
.socket {
    position: absolute;
    left: 0dp;
    top: 0dp;
}

/* How many, top left, where the classic icon drew it. */
.count {
    position: absolute;
    left: 1dp;
    top: 1dp;
    padding: 0dp 2dp;
    line-height: 12dp;
    font-size: 10dp;
    font-weight: bold;
    color: #ffffff;
    border-radius: 2dp;
    background-color: #00000080;
    font-effect: outline(1px #000000c0);
}

/* --- the basket ------------------------------------------------------------------ */
.cartcol {
    float: left;
    width: 227dp;
    margin-left: 8dp;
}

.head {
    display: flex;
    flex-direction: row;
    align-items: center;
    height: 18dp;
    padding: 0dp 2dp;
}
.head + .cart { margin-top: 1dp; }
.htitle {
    flex-grow: 1;
    font-size: 11dp;
    font-weight: bold;
    color: #f0f0f0;
}
.hcount { font-size: 10dp; }

/* Five across: 5 x ( 42 + 2 ) = 220 of content plus 1 to spare; with the
   well's padding and border that is 227 outside, the column's width. */
.cart {
    display: flow-root;
    width: 221dp;
    padding: 3dp 1dp 1dp 3dp;
}

.total {
    display: flex;
    flex-direction: row;
    align-items: center;
    height: 20dp;
    margin-bottom: 4dp;
    padding: 0dp 3dp;
    font-size: 10dp;
}
.total .ui-muted { flex-grow: 1; }
.tval {
    display: flex;
    flex-direction: row;
    align-items: center;
    font-size: 11dp;
    font-weight: bold;
}
.tval.cost { color: #ffb070; }
.tval.earn { color: #9ad870; }
.umark { margin-right: 4dp; }

/* What you have and what the trade leaves you. */
.purse {
    padding: 4dp 5dp;
}
.prow {
    display: flex;
    flex-direction: row;
    align-items: center;
    height: 16dp;
    font-size: 10dp;
}
.prow .ui-muted { flex-grow: 1; }
.pval {
    font-weight: bold;
    color: #ffe070;
}
.prow.short .after { color: #ff6a5a; }

.buttons {
    display: flex;
    flex-direction: row;
    margin-top: 6dp;
}
.act { flex: 1; }
.act + .act { margin-left: 4dp; }
/* Nothing in the basket: Confirm has nothing to send, and does not light up
   under the mouse either. */
.confirm.off { color: #a0a0a0; }
.confirm.off:hover {
    background-color: #3a3a3aff;
    border-color: #565656ff;
}
