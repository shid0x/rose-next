/* UI2 status panel -- LAYOUT ONLY ( colours and materials: rose-theme.rcss ).
   Reload in game with /uireload. Sizes are dp, so [VIDEO] UI_SCALE scales
   them; the buff strip hangs under this panel and follows it. */

#status {
    left: 3dp;
    top: 3dp;
    width: 230dp;
    cursor: pointer;           /* the whole panel is the self-target button */
}

/* --- name / level ------------------------------------------------------------ */
.head {
    display: flex;
    flex-direction: row;
    align-items: center;
    height: 18dp;
    padding-left: 3dp;
    padding-right: 3dp;
    margin-bottom: 3dp;
}

.name {
    flex-grow: 1;
    font-size: 12dp;
    font-weight: bold;
    color: #f0f0f0;
    font-effect: shadow(1px 1px #000000c0);
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.level {
    font-weight: bold;
    color: #ff9a5a;
}

/* --- HP / MP ----------------------------------------------------------------- */
.bar {
    height: 17dp;
    margin-bottom: 2dp;

    display: flex;
    flex-direction: row;
    align-items: center;
    padding-left: 5dp;
    padding-right: 5dp;
}

.bar .tag { width: 22dp; font-size: 10dp; }
.bar .val { flex-grow: 1; text-align: center; }
.bar .pct { width: 34dp; text-align: right; }

/* Low HP: the fill breathes brighter so the danger reads without a number. */
@keyframes low-hp {
    from { background-color: #922500ff; }
    to   { background-color: #d8401cff; }
}
.ui-gauge-fill.hp.low {
    animation: 0.6s quadratic-in-out infinite alternate low-hp;
}

/* --- EXP ----------------------------------------------------------------------- */
.expbar {
    height: 7dp;
    margin-top: 1dp;
    margin-bottom: 4dp;
}

/* Tenths. Positioned above the fill ( which is itself positioned ). */
.tick {
    position: absolute;
    z-index: 1;
    top: 0dp;
    bottom: 0dp;
    width: 1dp;
    background-color: #00000070;
}

/* --- job / exp / weight / menu ----------------------------------------------- */
.foot {
    display: flex;
    flex-direction: row;
    align-items: center;
    padding-left: 3dp;
}

.job {
    flex-grow: 1;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.stat {
    margin-left: 8dp;
    font-size: 10dp;
}

.menu {
    margin-left: 4dp;
    height: 18dp;
    line-height: 17dp;
    padding-left: 8dp;
    padding-right: 8dp;
    font-size: 10dp;
}
