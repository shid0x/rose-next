<rml>
<head>
    <title>Inventory</title>
    <!-- Theme first ( materials, colours, states ), then this panel's layout. -->
    <link type="text/rcss" href="rose-theme.rcss"/>
    <link type="text/rcss" href="inventory.rcss"/>
</head>
<body data-model="inventory">
    <!--
        UI2 inventory ( RoseRmlInventory ), replacing CItemDlg. Opened and
        closed through IT_MGR like any window ( menu, Alt+I, Escape ).

        Left, in sections: Gear ( a paper doll, the ammo row, what it adds up
        to ), PAT ( the five cart / castle gear parts and the mounted stats
        the server previews for them ) and Costume ( each costume slot where
        the piece it covers sits on the gear doll -- while this is on screen,
        equipping armour puts it in the costume slot ). Right: the bag --
        three tabs of 6x5 slots with Gear, the riding-parts page with PAT, the
        equipment page with Costume.

        Drag an item to move it: bag to doll equips ( a gem onto a socketed
        piece sockets it ), doll to bag unequips; onto a shop / the bank / a
        trade / the skill bar, or out to drop it. Double-click to use, equip
        or unequip. Alt+click previews, Shift+click links it in chat,
        Ctrl+click adds it to the wishlist. Click the money to drop some, or to
        offer it in an open trade.

        The whole window is a drop target for items ( DLG_TYPE_ITEM ); every
        cell carries slot-kind / slot-index for the drop commands' questions.
    -->
    <div id="inventory" class="ui-window" data-attr-drop-target="drop_type">
        <handle move_target="inventory" class="ui-titlebar">
            <span class="ui-title">Inventory</span>
            <span class="ui-close" data-event-click="close()">X</span>
        </handle>

        <div class="columns">
            <!-- What you wear. -->
            <div class="gearcol">
                <div class="tabs">
                    <span class="ui-btn tab" data-class-on="section == 0" data-event-click="set_section(0)">Gear</span>
                    <span class="ui-btn tab" data-class-on="section == 1" data-event-click="set_section(1)">PAT</span>
                    <span class="ui-btn tab" data-class-on="section == 2" data-event-click="set_section(2)">Costume</span>
                </div>

                <div class="doll ui-well" equip-area="1" data-if="section == 0">
                    <div class="cell ui-icon" data-for="c : gear"
                         data-attr-slot-kind="c.kind" data-attr-slot-index="c.index"
                         data-class-spacer="c.index == 0" data-class-empty="!c.filled"
                         data-class-dim="c.dim" data-class-worn="c.worn"
                         data-event-mousedown="press(c.kind, c.index)" data-event-dblclick="use(c.kind, c.index)">
                        <img data-if="c.filled" data-attr-src="c.src" data-attr-rect="c.rect"/>
                        <span class="label" data-if="!c.filled">{{c.label}}</span>
                        <div class="gem" data-if="c.socket == 2"><img data-attr-src="c.gem_src" data-attr-rect="c.gem_rect"/></div>
                        <img class="socket" data-if="c.socket == 1" src="3DData/Control/Res/SOKET.DDS"/>
                    </div>
                </div>

                <div class="ammo ui-well" equip-area="1" data-if="section == 0">
                    <span class="ammohead ui-muted">Ammo</span>
                    <div class="cell ui-icon" data-for="c : ammo"
                         data-attr-slot-kind="c.kind" data-attr-slot-index="c.index"
                         data-class-empty="!c.filled" data-class-dim="c.dim"
                         data-event-mousedown="press(c.kind, c.index)" data-event-dblclick="use(c.kind, c.index)">
                        <img data-if="c.filled" data-attr-src="c.src" data-attr-rect="c.rect"/>
                        <span class="label" data-if="!c.filled">{{c.label}}</span>
                        <span class="count" data-if="c.count > 0">{{c.count}}</span>
                    </div>
                </div>

                <div class="summary" data-if="section == 0">
                    <span class="stat"><span class="ui-muted">ATK</span> {{atk}}</span>
                    <span class="stat"><span class="ui-muted">DEF</span> {{def}}</span>
                    <span class="stat"><span class="ui-muted">M.RES</span> {{res}}</span>
                </div>

                <!-- PAT: the parts, then what they add up to once mounted. -->
                <div class="parts ui-well" equip-area="1" data-if="section == 1">
                    <div class="cell ui-icon" data-for="c : pat"
                         data-attr-slot-kind="c.kind" data-attr-slot-index="c.index"
                         data-class-empty="!c.filled" data-class-dim="c.dim" data-class-worn="c.worn"
                         data-event-mousedown="press(c.kind, c.index)" data-event-dblclick="use(c.kind, c.index)">
                        <img data-if="c.filled" data-attr-src="c.src" data-attr-rect="c.rect"/>
                        <span class="label" data-if="!c.filled">{{c.label}}</span>
                        <div class="gem" data-if="c.socket == 2"><img data-attr-src="c.gem_src" data-attr-rect="c.gem_rect"/></div>
                        <img class="socket" data-if="c.socket == 1" src="3DData/Control/Res/SOKET.DDS"/>
                    </div>
                </div>

                <!-- Costume: the same positions as the gear doll. -->
                <div class="doll ui-well" equip-area="1" data-if="section == 2">
                    <div class="cell ui-icon" data-for="c : costume"
                         data-attr-slot-kind="c.kind" data-attr-slot-index="c.index"
                         data-class-spacer="c.index == 0" data-class-empty="!c.filled"
                         data-class-dim="c.dim" data-class-worn="c.worn"
                         data-event-mousedown="press(c.kind, c.index)" data-event-dblclick="use(c.kind, c.index)">
                        <img data-if="c.filled" data-attr-src="c.src" data-attr-rect="c.rect"/>
                        <span class="label" data-if="!c.filled">{{c.label}}</span>
                    </div>
                </div>
                <div class="note ui-muted" data-if="section == 2">While this tab is open, equipping armour puts it in its costume slot. Costumes change your look, not your stats.</div>

                <div class="tune ui-well" data-if="section == 1">
                    <div class="trow" data-for="t : tune" data-attr-tune-tip="t.fuel ? 2 : 1">
                        <span class="tlabel">{{t.label}}</span>
                        <span class="tval">{{t.value}}</span>
                    </div>
                </div>
            </div>

            <!-- The bag. -->
            <div class="bagcol">
                <div class="tabs" data-if="section == 0">
                    <span class="ui-btn tab" data-class-on="page == 0" data-event-click="set_page(0)">Equip<span class="n">{{count0}}</span></span>
                    <span class="ui-btn tab" data-class-on="page == 1" data-event-click="set_page(1)">Use<span class="n">{{count1}}</span></span>
                    <span class="ui-btn tab" data-class-on="page == 2" data-event-click="set_page(2)">Etc<span class="n">{{count2}}</span></span>
                </div>
                <div class="tabs" data-if="section == 1">
                    <span class="ui-btn ui-static tab on">Riding parts<span class="n">{{count3}}</span></span>
                </div>
                <div class="tabs" data-if="section == 2">
                    <span class="ui-btn ui-static tab on">Equip<span class="n">{{count0}}</span></span>
                </div>

                <div class="grid ui-well" bag-area="1">
                    <div class="cell ui-icon" data-for="c : cells"
                         data-attr-slot-kind="c.kind" data-attr-slot-index="c.index"
                         data-class-empty="!c.filled" data-class-dim="c.dim" data-class-worn="c.worn"
                         data-event-mousedown="press(c.kind, c.index)" data-event-dblclick="use(c.kind, c.index)">
                        <img data-if="c.filled" data-attr-src="c.src" data-attr-rect="c.rect"/>
                        <div class="cd" data-if="c.cd > 0" data-style-height="c.cd + '%'"></div>
                        <div class="gem" data-if="c.socket == 2"><img data-attr-src="c.gem_src" data-attr-rect="c.gem_rect"/></div>
                        <img class="socket" data-if="c.socket == 1" src="3DData/Control/Res/SOKET.DDS"/>
                        <span class="count" data-if="c.count > 0">{{c.count}}</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="footer">
            <span class="money ui-click" data-event-click="money()"><span class="coin"></span><span class="mval">{{money}}</span></span>
            <div class="weight" data-class-heavy="weight_level == 1" data-class-over="weight_level == 2">
                <span class="wlabel ui-muted">Weight</span>
                <div class="wbar"><div class="wfill" data-style-width="weight_pct + '%'"></div></div>
                <span class="wval">{{weight}}</span>
            </div>
        </div>
    </div>
</body>
</rml>
