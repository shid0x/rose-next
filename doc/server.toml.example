[database]
connection_string = "postgres://postgres:postgres@localhost/rose-next"

[loginserver]
ip = "127.0.0.1"
port = 29000
server_port = 19000
password = "password"
log_level = 0
log_path = "C:\\rose-next\\server\\logs\\loginserver.log"
minimum_access_level = 1
max_users = 0

[worldserver]
ip = "127.0.0.1"
port = 29100
server_port = 19001
world_name = "1Rose Next" # Prepend number to control ordering in world list
data_dir = "C:\\rose-next\\server\\data"
clanmark_dir = "C:\\rose-next\\server\\data\\clanmark"
log_level = 0
log_path = "C:\\rose-next\\server\\logs\\worldserver.log"

[gameserver]
ip = "127.0.0.1"
port = 29200
server_name = "Channel 1"
data_dir = "C:\\rose-next\\server\\data"
log_level = 0
log_path = "C:\\rose-next\\server\\logs\\gameserver.log"

[game]
base_move_speed = 200
base_attack_power = 0
base_attack_speed = 0
base_hit = 0
base_crit = 0
stun_immunity_ms = 10000  # after a monster's stun ends, no monster can stun that player for this long (0 = off)
# Height rules (doc/pathfinding-and-z-plan.md, Phase 3). Every key is optional: these are the
# defaults. Needs the zone walk grids (scripts/nav-bake.py); a zone without one stays 2D.
# GMs can change them live with /nav set.
[nav]
aoe_vertical = 1        # 0 = 2D as before, 1 = band, 2 = sphere, 3 = cylinder
aoe_band_base_cm = 500  # band: a target may be this far above or below the centre...
aoe_band_slope_pct = 70 # ...plus this % of its horizontal distance from it
mob_layer_aggro = 1     # monster aggro and help calls use the same rule
spawn_roofs = 1         # re-roll a regen spawn the client would draw on a roof
ai_walls = 1            # idle walks (wander, flee, leash, summon follow) walk their line on the grid
spawn_reach = 1         # re-roll a regen spawn behind a wall or off the walkable ground
pathing = 1             # chases, leashes, summon follow and CTRL+click orders find a way round (A*)
path_zones = "all"      # zones whose monsters path: "all", "none", or "31,32,33,62"
path_expansions = 4000  # cells one search may expand
path_tick_searches = 6  # searches a zone tick may run (more wait for the next tick)
path_tick_expansions = 8000
path_tick_us = 3000     # wall-clock a zone tick may spend searching, microseconds
path_lead_ms = 100      # send a path's next leg this long before the corner (0 = at the corner)
send_z = 1              # monsters, summons, NPCs and loot are drawn on the floor the server walks them on (needs the matching client)
vertical_range = 1      # attacks and targeted skills reach only within the vertical band (5 m + 70% of the distance)
vertical_giveup_ms = 3000 # a monster stuck under or over its target gives up after this
