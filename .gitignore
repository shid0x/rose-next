/[Bb]in/
/[Bb]uild/
# Building a .vcxproj standalone leaves $(SolutionDir) unresolved, so its
# output lands in src/<project>/build/ instead of the root build/. The rule
# above is root-anchored and does not catch that, so a later `git add -A`
# sweeps .obj/.pdb into the tree -- and the root .gitattributes then mangles
# them as text. Not anchored globally because the reference dumps under
# "iRose Community/" have tracked paths containing build/.
src/*/build/
/[Dd]ist/
/[Dd]ev/
/[Ll]ib/

# Assets build data
.pipeline/

# Visual studio
*.vs/
*.pch
*.sdf
*.vcxproj.user

# Visual studio code
.vscode/

# Generated files
*.inc
src/common-lib/include/rose/common/common_interface.h
src/engine/include/zz_build_count
# Game data: contents are NOT tracked. Only the folder structure (one
# .gitkeep per top-level dir) and data/README.md are kept so people know
# where to place their own data files.
data/*
!data/README.md
!data/*/
data/*/*
!data/*/.gitkeep
Exes/*
!Exes/server.toml
/originalfiles/
/rose-offline/
# Python
__pycache__/
*.pyc
/iRose-master/
/AlternateEngine/
# Environment
.env
target/
# Rust
/src/bin
src/target/
/iRose Community/
/rose-offline-client/
/editor3/
/project 137/
Project 137.rar
/mapforge/
/revise/
/.claude/